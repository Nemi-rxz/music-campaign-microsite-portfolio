# Poll persistence (shared + durable across all visitors on Vercel)
#
# The /api/poll route auto-selects its backend:
#   1. Vercel KV  -> used when BOTH vars below are present (recommended for production)
#   2. local file -> used in dev when a writable filesystem exists
#   3. in-memory  -> last-resort fallback (not shared/persistent)
#
# To enable real shared voting on Vercel:
#   Dashboard -> Storage -> Create Database -> KV  (auto-injects these two env vars)
# Then redeploy. /api/poll will then report "store":"kv".
KV_REST_API_URL=
KV_REST_API_TOKEN=
